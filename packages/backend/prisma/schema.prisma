generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Enums
enum FlagType {
  BOOLEAN
  STRING
  NUMBER
  JSON
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

// 2. User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. Project Model
model Project {
  id          String        @id @default(uuid())
  name        String
  key         String        @unique
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations to Environment & Flag
  environments Environment[]
  flags        Flag[]
}

// 4. Environment Model
model Environment {
  id        String          @id @default(uuid())
  name      String
  type      EnvironmentType
  apiKey    String          @unique @default(uuid())
  
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  flagStates FlagEnvironmentState[]
  createdAt  DateTime               @default(now())

  @@index([apiKey])
}

// 5. Flag Model
model Flag {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  type         FlagType @default(BOOLEAN)
  defaultValue String

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  states    FlagEnvironmentState[]
  rules     FlagRule[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// 6. FlagEnvironmentState Model
model FlagEnvironmentState {
  id        String  @id @default(uuid())
  isEnabled Boolean @default(false)

  flagId String
  flag   Flag   @relation(fields: [flagId], references: [id], onDelete: Cascade)

  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([flagId, environmentId])
}

// 7. FlagRule Model
model FlagRule {
  id         String   @id @default(uuid())
  flagId     String
  flag       Flag     @relation(fields: [flagId], references: [id], onDelete: Cascade)
  priority   Int
  conditions Json
  serveValue String
  percentage Int?
  createdAt  DateTime @default(now())

  @@index([flagId, priority])
}

// 8. AuditLog Model
model AuditLog {
  id         String   @id @default(uuid())
  flagId     String
  flag       Flag     @relation(fields: [flagId], references: [id], onDelete: Cascade)
  actorEmail String
  action     String
  changes    Json
  createdAt  DateTime @default(now())

  @@index([flagId, createdAt])
}